        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, mediatype: 'video', mimetype: 'video/mp4', media: $json.mediaUrl, caption: $json.texto, fileName: 'video.mp4' }) }}",
        "options": {
          "timeout": 30000
